# The window keeps its layout across closing and opening it again, with no exception from copying,
# comparing or saving its state. #125 only adds unit tests, so this checks the window's state still behaves.
open-window
new-script Panels
set-window-height 420
screenshot first-open
close-window
open-window
select-script Panels
screenshot reopened
expect-no-exceptions
close-window
open-window
set-window-height 600
close-window
expect-no-exceptions
